<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/slideshow_controls_holder"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/slideshow_controls_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/small_margin"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/slideshow_progress_ring"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:max="10000"
            android:progress="10000"
            app:indicatorColor="#CCFFFFFF"
            app:indicatorSize="44dp"
            app:trackColor="#26FFFFFF"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

        <ImageButton
            android:id="@+id/slideshow_play_pause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/slideshow_pause"
            android:src="@drawable/ic_pause_outline_vector"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/slideshow_stop"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/small_margin"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/slideshow_stop"
        android:src="@drawable/ic_cross_vector"
        app:tint="#FFFFFF" />
</LinearLayout>
